# Environment variables override values in the project-root .env file.
# SQLite relative paths are resolved against the project root.
MEMORY_OS_DATABASE_URL=sqlite:///data/memory.db
MEMORY_OS_LOG_LEVEL=INFO
MEMORY_OS_KNOWLEDGE_DIR=knowledge
MEMORY_OS_SYNC_ENABLED=true
MEMORY_OS_SYNC_INTERVAL=2
MEMORY_OS_DELETION_GRACE=10

# AI is disabled until a provider profile and credentials are configured.
# Copy config/ai-providers.example.yml to config/ai-providers.yml, then restart.
MEMORY_OS_AI_ENABLED=false
MEMORY_OS_AI_CONFIG_FILE=config/ai-providers.yml
MEMORY_OS_AI_MAX_INPUT_CHARS=20000
# Visual configuration is writable locally; container configuration is host-managed.
MEMORY_OS_CONFIGURATION_READ_ONLY=false
# Optional default-profile override; omit it to use the YAML default.
# MEMORY_OS_AI_DEFAULT_PROFILE=deepseek
# Secrets stay in environment/.env, never the YAML profiles.
MEMORY_OS_AI_KEYS__OPENAI=
MEMORY_OS_AI_KEYS__DEEPSEEK=
MEMORY_OS_AI_KEYS__QWEN=
MEMORY_OS_AI_KEYS__SILICONFLOW=
MEMORY_OS_AI_KEYS__DOUBAO=
MEMORY_OS_AI_KEYS__KIMI=
MEMORY_OS_AI_KEYS__GLM=
MEMORY_OS_AI_KEYS__ANTHROPIC=
MEMORY_OS_AI_KEYS__GEMINI=

# RAG is independent of generation AI; ask additionally requires AI enabled.
# Copy config/embedding-providers.example.yml to config/embedding-providers.yml.
# Start Qdrant with: docker compose --profile rag up -d qdrant
MEMORY_OS_RAG_ENABLED=false
MEMORY_OS_EMBEDDING_CONFIG_FILE=config/embedding-providers.yml
# MEMORY_OS_EMBEDDING_DEFAULT_PROFILE=embedding
MEMORY_OS_AI_KEYS__EMBEDDING=
# Local API uses loopback; Compose API always uses http://qdrant:6333.
MEMORY_OS_RAG_QDRANT_URL=http://127.0.0.1:6333
